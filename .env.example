# =============================================================================
# Autonomous Evolutionary Crypto Trading Laboratory — environment configuration
# =============================================================================

# --- Trading mode -----------------------------------------------------------
# One of: paper | shadow | live
# paper  = fully simulated, never touches Hyperliquid order endpoints
# shadow = live market data, decisions computed, orders logged but NOT sent
# live   = real orders sent to Hyperliquid (requires the safety gates below)
TRADING_MODE=paper

# --- Hyperliquid --------------------------------------------------------------
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=
MARKET_SYMBOL=SOL
MARKET_TIMEFRAME=1m

# --- Ollama (external API, NOT local) ---------------------------------------
OLLAMA_BASE_URL=https://your-ollama-api-url
# Optional: multiple keys (e.g. several free-tier accounts) to spread load
# and dodge per-key rate limits, comma-separated. When set, this replaces
# OLLAMA_API_KEY above — every request (and every retry) round-robins to
# the next key in the list, so a 429 on one key is retried on the next one
# instead of backing off on the same rate-limited key.
#   OLLAMA_API_KEYS=key-one,key-two,key-three,key-four,key-five
OLLAMA_API_KEYS=
# Worker re-reads the keys above every N seconds (0 disables); `kill -HUP <worker>` forces an immediate reload.
OLLAMA_KEY_REFRESH_SECONDS=300
# Brute-force lockout / rate limit (in-process) and SSE caps.
API_AUTH_MAX_FAILURES=10
API_AUTH_FAILURE_WINDOW_SECONDS=300
API_AUTH_LOCKOUT_SECONDS=300
API_RATE_LIMIT_PER_MINUTE=600
API_MAX_SSE_STREAMS=20
API_MAX_SSE_STREAMS_PER_PRINCIPAL=5
API_SSE_MAX_AGE_SECONDS=3600
# OpenAPI/Swagger UI at /docs are OFF unless this is true.
EXPOSE_API_DOCS=false
OLLAMA_MODEL=your-model
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=3
OLLAMA_CONCURRENCY=10

# --- Population ---------------------------------------------------------------
AGENT_COUNT=500
AGENT_STARTING_BALANCE=100

# --- Risk ----------------------------------------------------------------------
MAX_LEVERAGE=5
MAX_POSITION_SIZE=0.5
MAX_DRAWDOWN=0.30
MAX_DAILY_LOSS=0.10

# --- Database --------------------------------------------------------------
# PostgreSQL is required for research, paper, shadow and production.
#
# NEVER commit real credentials.
# Put real values in .env or deployment secret management.

DATABASE_URL=postgresql+asyncpg://trading:CHANGE_ME@127.0.0.1:5432/trading_lab
DATABASE_URL_SYNC=postgresql://trading:CHANGE_ME@127.0.0.1:5432/trading_lab

# Run `alembic upgrade head` against it before starting any process.
# SQLite may still be used for isolated unit tests (see TESTING below) — it is never a
# silent runtime fallback; a paper/shadow/live/research process configured with a sqlite
# DATABASE_URL and TESTING unset fails to start with a clear error.
# Three processes (api, worker, research) share the server: 3 x (POOL_SIZE + MAX_OVERFLOW) must stay under ~90% of its
# max_connections (the app refuses to start otherwise). Tell it what your PostgreSQL uses (`SHOW max_connections`):
DATABASE_SERVER_MAX_CONNECTIONS=100
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=10000                 # PostgreSQL: max wait for a lock
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=120000 # PostgreSQL: kill a forgotten open transaction
# Explicit escape hatch for isolated unit tests ONLY (set by tests/conftest.py, never by a
# real runtime process) — allows a sqlite DATABASE_URL without the startup error above.
TESTING=false

# --- Paper execution simulation ---------------------------------------------
PAPER_FEE_RATE=0.00045                # taker
PAPER_MAKER_FEE_RATE=0.00015          # resting take-profit limit exits
PAPER_SLIPPAGE_BPS=2                  # base adverse slippage on market orders
PAPER_SLIPPAGE_IMPACT_BPS_PER_10K=0.5 # extra bps per $10k notional
PAPER_STOP_SLIPPAGE_MULTIPLIER=2.0    # stops / liquidations slip more
PAPER_LATENCY_MS=150                  # REPORTED latency (no real sleeping unless PAPER_SIMULATE_LATENCY_SLEEP=true)
PAPER_LATENCY_JITTER_MS=50
PAPER_LATENCY_DRIFT_BPS_PER_SEC=2.0   # random price drift per second of simulated latency
PAPER_PARTIAL_FILL_PROBABILITY=0.02
PAPER_PARTIAL_FILL_MIN_FRACTION=0.5
PAPER_REJECT_PROBABILITY=0.005        # entries only; exits are never rejected
PAPER_MIN_ORDER_NOTIONAL=10           # Hyperliquid's real minimum is 10; 0 disables
# next_open = entries/exits decided on the close of bar N fill at the OPEN of bar N+1 (matches the backtest; no look-ahead)
PAPER_FILL_TIMING=next_open
TRAILING_STOP_USES_SAME_BAR_EXTREME=true   # worst-case intrabar path for trailing stops (paper, shadow AND backtest)
EXIT_FORCE_SETTLE_AFTER_ATTEMPTS=3     # a position whose exit keeps failing is settled at the modelled price
AGENT_MIN_VIABLE_EQUITY=1.0           # flat agents below this equity are retired as DEAD (untradeable zombies)
PAPER_QUANTITY_STEP=0.01
PAPER_RANDOM_SEED=1337
# Margin model (cross margin, one position per agent)
MAINTENANCE_MARGIN_RATE=0.025
LIQUIDATION_FEE_RATE=0.005
LIQUIDATION_IS_FATAL=true
MAX_EXPOSURE_MULTIPLE=2.0             # notional / equity hard cap
MAX_LOSS_PER_TRADE_FRACTION=0.05      # loss at the protective stop <= 5% of equity
AGENT_BANKRUPTCY_EQUITY_FRACTION=0.0  # equity <= starting_balance * this => DEAD (permanent)

# --- Housekeeping ---
DECISION_RETENTION_DAYS=7             # prune legacy no-op decision rows older than this (scripts.prune_decisions)

# --- Market data ---------------------------------------------------------------
CANDLE_FINALITY_GRACE_MS=1500         # a bar is "confirmed" only this long after its close
CANDLE_WAIT_DEADLINE_SECONDS=20       # wait for the exchange to publish the closed bar
MAX_CATCHUP_BARS=5                    # replay (exits only) after an overrun
GAP_CHECK_WINDOW_BARS=300             # unrecovered hole in this window => NO NEW ENTRIES
DATA_STALE_THRESHOLD_SECONDS=180
MARKET_WS_ENABLED=true                # WebSocket = primary stream; REST = warm-up/backfill/fallback
WS_PING_INTERVAL_SECONDS=30
WS_STALE_AFTER_SECONDS=90
WORKER_LEASE_TTL_SECONDS=90
WORKER_LEASE_HEARTBEAT_SECONDS=30

# --- Council / evolution toggles --------------------------------------------
COUNCIL_ENABLED=true
JUDGE_ENABLED=true
EVOLUTION_ENABLED=true

# AI reasoning cadence — how often (in candles) the council actually invokes
# Ollama vs. reusing the last shared market context.
COUNCIL_INTERVAL_CANDLES=5
COUNCIL_CONSENSUS_MARGIN=2
# Below this many successfully-responding analysts (of 8), the council cycle
# is INCOMPLETE: forced NEUTRAL, trade_allowed=false, no new trades this candle.
COUNCIL_MIN_SUCCESSFUL_ANALYSTS=6
EVOLUTION_INTERVAL_HOURS=24
# Council deadlines (must be < the candle interval): slow analysts are CANCELLED, quorum decides.
COUNCIL_DEADLINE_SECONDS=45
COUNCIL_ANALYST_TIMEOUT_SECONDS=30
# How the council shapes (never dictates) agent decisions:
COUNCIL_VETO_CONFIDENCE=0.60
COUNCIL_OPPOSED_SIZE_PENALTY=0.50
COUNCIL_ALIGNED_SIZE_BONUS=0.15
COUNCIL_NEUTRAL_SIZE_MODIFIER=0.75

# --- Research / evolution (scheduled; python -m scripts.run_research) ------------
# Runs only when: enabled, interval elapsed, generation old enough, real paper
# history exists, and enough confirmed market data exists. Skips are recorded.
RESEARCH_WINDOW_CANDLES=20160
RESEARCH_MIN_CANDLES=3000
RESEARCH_TRAIN_FRACTION=0.6
RESEARCH_VALIDATION_FRACTION=0.2      # the remaining 20% is the protected FINAL OOS slice
RESEARCH_MIN_GENERATION_AGE_HOURS=12
RESEARCH_MIN_CLOSED_TRADES=30
RESEARCH_SURVIVOR_FRACTION=0.2
RESEARCH_EPOCH_MAX_AGE_DAYS=30              # warn (never auto-renew) when the sealed OOS holdout is older than this
RESEARCH_OOS_MAX_EVALUATIONS_PER_LINEAGE=3   # adaptive-tuning guard for the sealed OOS holdout
RESEARCH_ADVERSARIAL_TOP_K=25
RESEARCH_POLL_SECONDS=300
RESEARCH_SEED=20260101
# Fitness weights (every component is bounded; see docs/architecture.md)
FITNESS_W_RETURN=1.0
FITNESS_W_RISK=1.0
FITNESS_W_CONSISTENCY=1.0
FITNESS_W_ROBUSTNESS=1.0
FITNESS_W_OOS=1.5
FITNESS_W_DRAWDOWN=2.0
FITNESS_W_INSTABILITY=1.0
FITNESS_W_CORRELATION=0.3
FITNESS_W_EXPECTANCY=0.5
FITNESS_W_REGIME=1.0
FITNESS_W_ADVERSARIAL=1.0
FITNESS_W_INACTIVITY=0.25
FITNESS_W_DEATH=1.0

# --- Shadow mode (TRADING_MODE=shadow): real order book, hypothetical fills, NO orders ever sent
SHADOW_ASSUMED_LATENCY_MS=250
SHADOW_BOOK_TTL_SECONDS=2
SHADOW_MAX_BOOK_LEVELS=20

# --- Live trading safety gates (ALL must be true to place a live order) -----
# Live order execution is NOT IMPLEMENTED (the adapter refuses). These gates are
# defence in depth; LIVE_PREREQUISITES_SIGNED_OFF is an explicit operator sign-off
# of docs/security.md's launch checklist (testnet, reconciliation, idempotency,
# emergency stop, auth, secrets).
LIVE_TRADING_ENABLED=false
LIVE_PREREQUISITES_SIGNED_OFF=false
LIVE_ACCOUNT_CONFIRMED=false
LOAD_AGENT_SNAPSHOT=

# --- Logging / observability -------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- API ----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Auth fails closed: with API_AUTH_REQUIRED=true and no API_KEYS every request is
# rejected. Generate entries with:  python -m scripts.hash_api_key <name> <role>
# Format: name:role:sha256hex[,name:role:sha256hex]   roles: viewer|researcher|operator|admin
API_AUTH_REQUIRED=true
API_KEYS=

# Provenance: overrides the git commit recorded on every experiment (containers without a .git directory).
CODE_VERSION=
