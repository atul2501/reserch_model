# =============================================================================
# Autonomous Evolutionary Crypto Trading Laboratory — environment configuration
# =============================================================================

# --- Trading mode -----------------------------------------------------------
# One of: paper | shadow | live
# paper  = fully simulated, never touches Hyperliquid order endpoints
# shadow = live market data, decisions computed, orders logged but NOT sent
# live   = real orders sent to Hyperliquid (requires the safety gates below)
TRADING_MODE=paper

# --- Hyperliquid --------------------------------------------------------------
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_WALLET_ADDRESS=0xC1B79F3f9fa9bfA4764DFCB5825D082E7d65e1a6
HYPERLIQUID_PRIVATE_KEY=0xa8fcd7c3a1e874bd89d8c742c63803a0cececa61eff120112eb93983e74f8b19
MARKET_SYMBOL=SOL
MARKET_TIMEFRAME=1m

# --- Ollama (external API, NOT local) ---------------------------------------
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=6c334e311f5b4ce98cf1abe97152dc2c.8WfCO3FuXNe4MX1XEv4ax1bM
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=3
OLLAMA_CONCURRENCY=10

# --- Population ---------------------------------------------------------------
AGENT_COUNT=500
AGENT_STARTING_BALANCE=100

# --- Risk ----------------------------------------------------------------------
MAX_LEVERAGE=5
MAX_POSITION_SIZE=0.5
MAX_DRAWDOWN=0.30
MAX_DAILY_LOSS=0.10

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./trading_lab.db
DATABASE_URL_SYNC=sqlite:///./trading_lab.db

# --- Paper execution simulation ---------------------------------------------
PAPER_FEE_RATE=0.00045
PAPER_SLIPPAGE_BPS=2
PAPER_LATENCY_MS=150

# --- Council / evolution toggles --------------------------------------------
COUNCIL_ENABLED=true
JUDGE_ENABLED=true
EVOLUTION_ENABLED=true

# AI reasoning cadence — how often (in candles) the council actually invokes
# Ollama vs. reusing the last shared market context.
COUNCIL_INTERVAL_CANDLES=5
COUNCIL_CONSENSUS_MARGIN=2
EVOLUTION_INTERVAL_HOURS=24

# --- Professional agent classification thresholds ---------------------------
PRO_MIN_TRADES=200
PRO_MIN_PROFIT_FACTOR=1.5
PRO_MAX_DRAWDOWN=0.20
PRO_MIN_OOS_SCORE=0.70

# --- Live trading safety gates (ALL must be true to place a live order) -----
LIVE_TRADING_ENABLED=false
LIVE_ACCOUNT_CONFIRMED=false
LOAD_AGENT_SNAPSHOT=

# --- Logging / observability -------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- API ----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
