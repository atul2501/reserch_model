[Unit]
Description=Trading Lab dashboard (Vite dev server)
After=network.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/reserch_model/frontend

# If node/npm come from nvm, `which node` / `which npm` in an interactive
# shell will show the real path (usually
# ~/.nvm/versions/node/vX.Y.Z/bin) — add that directory to PATH below.
# systemd does not read your .bashrc/.nvmrc, so nvm's PATH setup has no
# effect here unless it's spelled out explicitly.
Environment="PATH=/home/ec2-user/.nvm/versions/node/v20.0.0/bin:/usr/local/bin:/usr/bin:/bin"
Environment="NODE_ENV=development"

ExecStart=/usr/bin/env npm run dev -- --host 0.0.0.0
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# NOTE: this runs Vite's DEV server, matching what you have running now.
# For anything beyond a personal/dev box, prefer a production build served
# by a real static file server instead (no HMR websocket overhead, no dev
# tooling in the loop):
#   cd frontend && npm run build && npx serve -s dist -l 5173
# or serve frontend/dist via nginx (see docker/frontend.Dockerfile in this
# repo for the equivalent multi-stage Docker build).
